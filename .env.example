# Local development for the Worker uses a .dev.vars file (not .env), read by
# `wrangler dev`. Copy the two lines below into .dev.vars and fill in your
# Razorpay TEST keys. Both are server-only and never shipped to the browser;
# the browser receives only the public key id, via the /api/create-order response.

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
