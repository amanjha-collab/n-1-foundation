# Copy to .env.local for local dev with `wrangler pages dev`.
# The VITE_ one is public (used by the browser checkout); the others are server-only.

# Public key id — safe to expose to the browser.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx

# Server-only (used by the Cloudflare Pages Functions). NEVER prefix these with VITE_.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
