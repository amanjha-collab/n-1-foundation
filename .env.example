# Local development for the Worker uses a .dev.vars file (not .env), read by
# `wrangler dev`. Copy the lines below into .dev.vars and fill in your values.
# All are server-only and never shipped to the browser.

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret

# Optional but recommended - safety-net webhook (see worker.js for setup steps)
RAZORPAY_WEBHOOK_SECRET=any_strong_random_string

# Email receipts via Resend (https://resend.com) - sign up, verify a sending
# domain, generate an API key. Until this is set, donations still work, they
# just skip sending the receipt email (same graceful "not configured" pattern
# as the Razorpay keys above).
RESEND_API_KEY=your_resend_api_key
ORG_EMAIL_FROM=n+1 Social Foundation <donations@nplusone.org.in>

# Where admin notifications (new donation alerts) get sent
ORG_EMAIL=info@nplusone.org.in

# Receipt content - already defaulted in worker.js to your real values, only
# set these if you need to override them
# ORG_PAN=AAHCN5356N
# ORG_80G_NUMBER=AAHCN5356N25PN02
# ORG_ADDRESS=Flat No.102, Plot No.15, CTS No.1336, S.No.132/2+3, Gulmohar Park, Aundh, Pune, Maharashtra 411007
