{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "n-1-foundation",
  "compatibility_date": "2026-08-06",

  // This project is a static Vite SPA with no Worker script, so there is no
  // "main" entrypoint. Declaring "assets" explicitly stops `wrangler deploy`
  // from falling back to framework auto-detection, which requires Vite >= 6.
  //
  // "single-page-application" serves index.html for any path that does not
  // match a built file, so client-side routes like /programs resolve instead
  // of 404ing. public/.htaccess does the same job on Apache/Hostinger but has
  // no effect on Cloudflare.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
